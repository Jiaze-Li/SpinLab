{
    "version": 6,
    "conditionDefinitions": [
        {
            "id": "device",
            "displayName": "Device",
            "matches": [
                {
                    "match": {
                        "type": "equals",
                        "value": "wafer"
                    },
                    "value": "wafer"
                }
            ]
        },
        {
            "id": "temperature",
            "displayName": "Temperature",
            "matches": [
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "K"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "k"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "C"
                    },
                    "value": "$MATCH"
                }
            ]
        },
        {
            "id": "current",
            "displayName": "Current",
            "matches": [
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "mA"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "A"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "uA"
                    },
                    "value": "$MATCH"
                }
            ]
        },
        {
            "id": "field",
            "displayName": "Field",
            "matches": [
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "T"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "mT"
                    },
                    "value": "$MATCH"
                },
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "Oe"
                    },
                    "value": "$MATCH"
                }
            ]
        },
        {
            "id": "shift",
            "displayName": "Shift",
            "matches": [
                {
                    "match": {
                        "type": "unit-suffix",
                        "value": "shift"
                    },
                    "value": "$MATCH"
                }
            ]
        }
    ]
}
