{
  "version": 1,
  "tokenization": {
    "separators": "_- ()",
    "caseFold": "preserve"
  },
  "sources": [
    "file",
    "parent",
    "grandparent"
  ],
  "batch": {
    "preferSampleId": true,
    "fallbackPatterns": [
      "^(B|Batch)\\d+$"
    ]
  },
  "channel": {
    "aliases": {
      "c1": "ch1",
      "c2": "ch2",
      "c3": "ch3",
      "ch1": "ch1",
      "ch2": "ch2",
      "ch3": "ch3"
    }
  },
  "rotationHintRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "90shift"
      },
      "value": "+90deg for I parallel B"
    }
  ],
  "conditions": {
    "extraConditions": {
      "current": "^-?\\d+(?:\\.\\d+)?(?:mA|A|uA)$",
      "device": "^-?\\d+(?:\\.\\d+)?(?:deg)$",
      "field": "^-?\\d+(?:\\.\\d+)?(?:T|mT|Oe)$",
      "shift": "^-?\\d+(?:\\.\\d+)?(?:shift)$",
      "temperature": "^-?\\d+(?:\\.\\d+)?(?:K|k|C)$"
    },
    "tokenMapRules": {
      "device": [
        {
          "match": {
            "scope": "tokens",
            "type": "equals",
            "value": "wafer"
          },
          "value": "wafer"
        }
      ]
    },
    "displayLabels": {}
  },
  "conditionDefinitions": [
    {
      "id": "device",
      "label": "Device",
      "kind": "token_map",
      "binding": "conditions.tokenMapRules.device"
    },
    {
      "id": "temperature",
      "label": "Temperature",
      "kind": "unit_suffix",
      "binding": "conditions.extraConditions.temperature"
    },
    {
      "id": "current",
      "label": "Current",
      "kind": "unit_suffix",
      "binding": "conditions.extraConditions.current"
    },
    {
      "id": "field",
      "label": "Field",
      "kind": "unit_suffix",
      "binding": "conditions.extraConditions.field"
    },
    {
      "id": "shift",
      "label": "Shift",
      "kind": "unit_suffix",
      "binding": "conditions.extraConditions.shift"
    }
  ],
  "measurementNameRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "MR"
      },
      "value": "MR"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "AHE"
      },
      "value": "ahe"
    }
  ]
}
