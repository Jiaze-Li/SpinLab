{
  "version": 1,
  "shared": {
    "tokenization": {
      "separators": "_- ()",
      "caseFold": "preserve"
    },
    "sampleId": {
      "patterns": [
        "^(PN|PT)\\d+$",
        "^S\\d+$"
      ]
    },
    "substrate": {
      "tokenSeparators": "_- ()",
      "originStandaloneTokens": [
        "o"
      ],
      "originContainsTokens": [
        "origin",
        "original"
      ],
      "treatmentKeywords": {
        "HF": [
          "hf"
        ],
        "b": [
          "b",
          "bake",
          "baked"
        ],
        "o": [
          "o",
          "origin",
          "original"
        ]
      },
      "materialTokens": [
        "STO",
        "NGO",
        "MAO",
        "MGO",
        "AL2O3",
        "SI",
        "POLY-SIO2 ON SI",
        "POLY-SIO2"
      ],
      "materialAliases": {
        "ONSI": "SI"
      },
      "materialDisplayNames": {
        "POLY-SIO2 ON SI": "poly-SiO2 on Si",
        "POLY-SIO2": "poly-SiO2 on Si",
        "MGO": "MgO",
        "AL2O3": "Al2O3",
        "SI": "Si"
      },
      "orientationTokens": [
        "111",
        "110",
        "001",
        "100",
        "0001"
      ],
      "orientationAliases": {
        "100": "001"
      },
      "orientationPattern": "\\d{3}"
    },
    "substrateTagRules": [
      {
        "match": {
          "scope": "tokens",
          "type": "equalsOrContainsAny",
          "values": [
            "HF"
          ]
        },
        "value": "HF"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equalsOrContainsAny",
          "values": [
            "B",
            "BAKE",
            "BAKED"
          ]
        },
        "value": "b"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "containsAny",
          "values": [
            "ORIGIN",
            "ORIGINAL"
          ]
        },
        "value": "o"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equalsAny",
          "values": [
            "O"
          ]
        },
        "value": "o"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "contains",
          "value": "STO111"
        },
        "value": "STO111"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "contains",
          "value": "STO001"
        },
        "value": "STO001"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equalsOrContainsAny",
          "values": [
            "STO"
          ]
        },
        "value": "STO"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equalsOrContainsAny",
          "values": [
            "NGO"
          ]
        },
        "value": "NGO"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "111"
        },
        "value": "111"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "001"
        },
        "value": "001"
      }
    ]
  },
  "inbox": {
    "sources": [
      "file",
      "parent",
      "grandparent"
    ],
    "batch": {
      "preferSampleId": true,
      "fallbackPatterns": [
        "^(B|Batch)\\d+$"
      ]
    },
    "measurementNameRules": [
      {
        "match": {
          "scope": "joined",
          "type": "containsAny",
          "values": [
            "3w",
            "3omega"
          ]
        },
        "value": "3W"
      },
      {
        "match": {
          "scope": "joined",
          "type": "containsAny",
          "values": [
            "xy",
            "rotation"
          ]
        },
        "value": "XY"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "MR"
        },
        "value": "MR"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "RT"
        },
        "value": "RT"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "AHE"
        },
        "value": "AHE"
      }
    ],
    "measurementTagRules": [
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "AMR"
        },
        "value": "AMR"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "PHE"
        },
        "value": "PHE"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "RXX"
        },
        "value": "Rxx"
      },
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "RXY"
        },
        "value": "Rxy"
      }
    ],
    "channel": {
      "aliases": {
        "ch1": "ch1",
        "c1": "ch1",
        "ch2": "ch2",
        "c2": "ch2",
        "ch3": "ch3",
        "c3": "ch3"
      }
    },
    "deviceRules": [],
    "rotationHintRules": [
      {
        "match": {
          "scope": "tokens",
          "type": "equals",
          "value": "90shift"
        },
        "value": "+90deg for I parallel B"
      }
    ],
    "conditionDefinitions": [
      {
        "id": "temperature",
        "label": "Temperature",
        "kind": "unit_suffix",
        "binding": "conditions.extraConditions.temperature"
      },
      {
        "id": "current",
        "label": "Current",
        "kind": "unit_suffix",
        "binding": "conditions.extraConditions.current"
      },
      {
        "id": "field",
        "label": "Field",
        "kind": "unit_suffix",
        "binding": "conditions.extraConditions.field"
      },
      {
        "id": "device",
        "label": "Device",
        "kind": "token_map",
        "binding": "conditions.tokenMapRules.device"
      }
    ],
    "conditions": {
      "extraConditions": {
        "temperature": "^-?\\d+(?:\\.\\d+)?(?:K|k|C|c|°C|°c)$",
        "current": "^-?\\d+(?:\\.\\d+)?(?:uA|µA|mA|A)$",
        "field": "^-?\\d+(?:\\.\\d+)?(?:mT|T)$"
      },
      "tokenMapRules": {
        "device": [
          {
            "match": {
              "scope": "tokens",
              "type": "equals",
              "value": "wafer"
            },
            "value": "wafer"
          }
        ]
      },
      "displayLabels": {
        "temperature": "Temperature",
        "current": "Current",
        "field": "Field",
        "device": "Device"
      }
    }
  },
  "library": {
    "registry": {
      "sampleHeaderAliases": [
        "sampleid",
        "sample",
        "sample id",
        "sample_no",
        "编号",
        "样品编号",
        "样品id"
      ],
      "excludedSheetNames": [
        "实验大纲"
      ],
      "sampleCellSeparators": "/／,，;；|",
      "batchHeaderAliases": [
        "编号",
        "Batch",
        "BatchID",
        "Batch Id"
      ],
      "substrateHeaderAliases": [
        "substrate",
        "Substrate",
        "衬底"
      ],
      "numericKeyAliases": {
        "厚度": [
          "预打",
          "生长次数"
        ],
        "温度": [
          "温度",
          "temperature"
        ],
        "氧压": [
          "氧压",
          "pressure"
        ],
        "能量": [
          "能量",
          "energy"
        ],
        "电压": [
          "电压",
          "kv"
        ],
        "磁场": [
          "磁场",
          "field"
        ],
        "电阻": [
          "电阻",
          "current"
        ]
      },
      "substrateMaterialTokens": [
        "STO",
        "NGO",
        "MAO",
        "MGO",
        "AL2O3",
        "SI",
        "POLY-SIO2 ON SI",
        "POLY-SIO2"
      ],
      "substrateProcessingKeywords": {
        "HF": [
          "HF"
        ],
        "b": [
          "B",
          "BAKE",
          "BAKED"
        ],
        "o": [
          "ORIGINAL",
          "ORIGIN",
          " O "
        ]
      },
      "metadataLookupAliases": {
        "batch": [
          "Batch",
          "BatchID",
          "Batch Name",
          "编号"
        ],
        "sample": [
          "Sample",
          "SampleID",
          "Sample Name",
          "样品"
        ],
        "measurement": [
          "Measurement",
          "MeasurementName",
          "Measurement Name"
        ],
        "device": [
          "Device",
          "DeviceName",
          "Device Name"
        ],
        "temperature": [
          "Temperature",
          "Temp",
          "T"
        ],
        "project": [
          "Project",
          "ProjectName",
          "Project Name"
        ]
      }
    },
    "importRules": {
      "supportedFileExtensions": [
        "csv",
        "txt",
        "dat",
        "lvm"
      ],
      "ignoredFileExtensions": [
        "gph"
      ]
    }
  }
}
