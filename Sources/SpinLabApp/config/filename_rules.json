{
  "version": 1,
  "tokenization": {
    "separators": "_- ()",
    "caseFold": "preserve"
  },
  "sources": [
    "file",
    "parent",
    "grandparent"
  ],
  "sampleId": {
    "patterns": [
      "^(PN|PT)\\d+$",
      "^S\\d+$"
    ]
  },
  "batch": {
    "preferSampleId": true,
    "fallbackPatterns": [
      "^(B|Batch)\\d+$"
    ]
  },
  "measurementNameRules": [
    {
      "match": {
        "scope": "joined",
        "type": "containsAny",
        "values": [
          "xy",
          "rotation"
        ]
      },
      "value": "XY"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "MR"
      },
      "value": "MR"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "RT"
      },
      "value": "RT"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "AHE"
      },
      "value": "AHE"
    }
  ],
  "measurementTagRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "AMR"
      },
      "value": "AMR"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "PHE"
      },
      "value": "PHE"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "RXX"
      },
      "value": "Rxx"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "RXY"
      },
      "value": "Rxy"
    }
  ],
  "substrateTagRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equalsOrContainsAny",
        "values": [
          "HF"
        ]
      },
      "value": "HF"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equalsOrContainsAny",
        "values": [
          "BAKE",
          "BAKED"
        ]
      },
      "value": "baked"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "containsAny",
        "values": [
          "ORIGIN",
          "ORIGINAL"
        ]
      },
      "value": "o"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equalsAny",
        "values": [
          "O"
        ]
      },
      "value": "o"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "contains",
        "value": "STO111"
      },
      "value": "STO111"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "contains",
        "value": "STO001"
      },
      "value": "STO001"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equalsOrContainsAny",
        "values": [
          "STO"
        ]
      },
      "value": "STO"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equalsOrContainsAny",
        "values": [
          "NGO"
        ]
      },
      "value": "NGO"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "111"
      },
      "value": "111"
    },
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "001"
      },
      "value": "001"
    }
  ],
  "channel": {
    "aliases": {
      "ch1": "ch1",
      "c1": "ch1",
      "ch2": "ch2",
      "c2": "ch2",
      "ch3": "ch3",
      "c3": "ch3"
    }
  },
  "deviceRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "wafer"
      },
      "value": "wafer"
    }
  ],
  "rotationHintRules": [
    {
      "match": {
        "scope": "tokens",
        "type": "equals",
        "value": "90shift"
      },
      "value": "+90deg for I parallel B"
    }
  ],
  "conditions": {
    "temperaturePattern": "^\\d+K$",
    "currentPattern": "^\\d+(?:\\.\\d+)?mA$",
    "fieldPattern": "^-?\\d+T$"
  }
}
